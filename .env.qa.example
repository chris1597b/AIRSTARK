# Credenciales QA (SOLO pruebas locales). NUNCA commitear el archivo real.
# 1. Copia a `.env.qa` (ignorado por git).
# 2. Si estas credenciales alguna vez vivieron en el repo, RÓTALAS en el
#    dashboard Supabase (el historial de git no se puede "desver").
AIRSTARK_QA_EMAIL_A=qa.profe.a+tag@example.com
AIRSTARK_QA_EMAIL_B=qa.profe.b+tag@example.com
# Password común (o por usuario con _A/_B si difieren):
AIRSTARK_QA_PASSWORD=cambia-esta-password
# AIRSTARK_QA_PASSWORD_A=...
# AIRSTARK_QA_PASSWORD_B=...
