{
  "compilerOptions": {
    "target": "ES2022",
    "experimentalDecorators": true,
    "useDefineForClassFields": false,
    "module": "ESNext",
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "skipLibCheck": true,
    "types": [
      "node",
      "vite/client"
    ],
    "moduleResolution": "bundler",
    "isolatedModules": true,
    "moduleDetection": "force",
    "allowJs": true,
    "jsx": "react-jsx",
    "paths": {
      "@/*": [
        "./*"
      ]
    },
    "allowImportingTsExtensions": true,
    "noEmit": true
  },
  // Las Edge Functions (Deno) viven en supabase/functions y se verifican al
  // desplegar en Supabase, no con el compilador web (usan imports esm.sh y
  // el global Deno, inexistentes en el toolchain Vite).
  "exclude": [
    "node_modules",
    "dist",
    "supabase/functions"
  ]
}